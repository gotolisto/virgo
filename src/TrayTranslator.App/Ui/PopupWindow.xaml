<Window x:Class="TrayTranslator.App.Ui.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tray Translator"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        MinWidth="240"
        MaxWidth="496"
        MaxHeight="376"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.Secondary}" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="4" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Theme.SurfaceHover}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.Foreground}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TextButton" TargetType="Button">
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.Foreground}" />
      <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="4" Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Theme.SurfaceHover}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
      <Setter Property="Foreground" Value="{DynamicResource Theme.AccentForeground}" />
      <Setter Property="Background" Value="{DynamicResource Theme.Accent}" />
    </Style>
  </Window.Resources>

  <!-- 8 px margin leaves room for the shadow. -->
  <Border Margin="8" CornerRadius="8" Background="{DynamicResource Theme.Background}"
          BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.28" />
    </Border.Effect>

    <Grid Margin="12,8,8,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Header: direction, swap, close -->
      <DockPanel Grid.Row="0" LastChildFill="True">
        <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                Content="&#xE711;" ToolTip="Close (Esc)" Click="OnCloseClick" />
        <Button x:Name="SwapButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                Content="&#xE8AB;" ToolTip="Translate the other way" Click="OnSwapClick" />
        <TextBlock x:Name="DirectionText" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource Theme.Secondary}" Text="…" />
      </DockPanel>

      <!-- One-off notice such as "Switched to Google" -->
      <TextBlock x:Name="NoticeText" Grid.Row="1" Margin="0,2,4,0" FontSize="12"
                 Foreground="{DynamicResource Theme.Warning}" Visibility="Collapsed" TextWrapping="Wrap" />

      <!-- Body -->
      <Grid Grid.Row="2" Margin="0,6,4,0">
        <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" Margin="0,6" Visibility="Collapsed">
          <Ellipse x:Name="Spinner" Width="18" Height="18" StrokeThickness="2.5"
                   Stroke="{DynamicResource Theme.Accent}" StrokeDashArray="9 6" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
              <RotateTransform x:Name="SpinnerRotation" />
            </Ellipse.RenderTransform>
          </Ellipse>
          <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Secondary}" Text="Translating…" />
        </StackPanel>

        <TextBox x:Name="ResultText" Visibility="Collapsed" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                 TextWrapping="Wrap" BorderThickness="0" Padding="0" Background="Transparent"
                 Foreground="{DynamicResource Theme.Foreground}" SelectionBrush="{DynamicResource Theme.Accent}"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 MaxHeight="260" MaxWidth="456" />

        <TextBlock x:Name="MessageText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,4"
                   Foreground="{DynamicResource Theme.Foreground}" MaxWidth="456" />
      </Grid>

      <!-- Footer buttons -->
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,4,0">
        <Button x:Name="ActionButton" Style="{StaticResource TextButton}" Visibility="Collapsed" Click="OnActionClick" />
        <Button x:Name="ReplaceButton" Style="{StaticResource TextButton}" Margin="8,0,0,0" Content="Replace"
                ToolTip="Paste the translation over the text you selected" Visibility="Collapsed" Click="OnReplaceClick" />
        <Button x:Name="CopyButton" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Content="Copy"
                Visibility="Collapsed" Click="OnCopyClick" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
