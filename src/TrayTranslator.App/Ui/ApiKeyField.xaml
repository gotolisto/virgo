<UserControl x:Class="TrayTranslator.App.Ui.ApiKeyField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <DockPanel LastChildFill="False">
      <TextBlock x:Name="LabelText" DockPanel.Dock="Left" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center">
        <Hyperlink x:Name="SignUpLink" Click="OnSignUpClick">Get a key</Hyperlink>
      </TextBlock>
    </DockPanel>
    <Grid Margin="0,6,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <PasswordBox x:Name="KeyBox" Grid.Column="0" PasswordChanged="OnPasswordChanged" />
      <Button x:Name="TestButton" Grid.Column="1" Margin="8,0,0,0" MinWidth="72" Content="Test" Click="OnTestClick" />
    </Grid>
    <TextBlock x:Name="StatusText" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
  </StackPanel>
</UserControl>
