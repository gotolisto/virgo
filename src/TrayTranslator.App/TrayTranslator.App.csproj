<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area icon (NotifyIcon); all windows are WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- WPF0001: Fluent ThemeMode is marked experimental; used for the settings windows only. -->
    <!-- WFO0003 asks WinForms apps to set DPI in code; this is a WPF app, where the manifest is the right place. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
    <!-- Lets the project build (not run) on Linux and macOS CI. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>TrayTranslator</AssemblyName>
    <RootNamespace>TrayTranslator.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StartupObject>TrayTranslator.App.Program</StartupObject>

    <!-- The one place the version lives. MAJOR.MINOR.PATCH. About and the tooltip read it from the assembly. -->
    <Version>0.1.0</Version>

    <Product>Tray Translator</Product>
    <Company>gotolisto</Company>
    <Copyright>Copyright © gotolisto</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- App.xaml is a plain page so Program.Main stays ours (Velopack's hook must run first). -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <None Remove="Assets\icon-256.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.15" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrayTranslator.Core\TrayTranslator.Core.csproj" />
  </ItemGroup>

</Project>
